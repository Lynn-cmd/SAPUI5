<mvc:View
    controllerName="sap.ui.demo.walkthrough.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    
    displayBlock="true">   
<Shell>
<App >
        <pages>

        <Page title="{i18n>HomePageTitle}"  titleAlignment="Center" >
            <content>
                <Panel 
                headerText="{i18n>PanelHeaderText}" 
                class="sapUiResponsiveMargin"
                width="auto">

                    <content>

                     <Button text="Press Me" 
                            press=".onPress" />

                    <Button 
                        text="{i18n>ShowHelloButtonText}" 
                        press=".onShowHello" 
                        class="sapUiSmallMargin"/>

                    <Input  value="{/recipient/name}"
                            description="Hello {/recipient/name}"
                            valueLiveUpdate="true"
                            width="60%"/>

                    <Text   text="{/recipient/name}"
                            class="sapUiSmallMargin"/>

                    </content>

                    <headerToolbar>
                    </headerToolbar>
                    <infoToolbar>
                    </infoToolbar>
                    
                </Panel>
            </content>
        
        </Page>

        </pages>
</App>

</Shell>


</mvc:View>