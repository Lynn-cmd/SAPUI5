<c:FragmentDefinition
	xmlns="sap.m"
	xmlns:c="sap.ui.core">

    <Dialog
            id="helloDialog"
            title="Hello {/recipient/name}"  >
            <content>
                <c:Icon
                    src="sap-icon://world"
                    size="8rem"
                    class="sapUiMediumMargin" />
            </content>

            <beginButton>
                <Button 
                    text="Close" 
                    press=".onCloseDialog" />
            </beginButton>
            
    </Dialog>
</c:FragmentDefinition>